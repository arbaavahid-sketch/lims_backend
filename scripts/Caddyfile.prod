# Caddyfile تولیدی — HTTPS خودکار (Let's Encrypt) + VirtualHost زوپ.
# دامنه از متغیر LIMS_DOMAIN خوانده می‌شود (در docker-compose.prod.yml ست می‌شود).
#
# ترفند VirtualHost: به SENAITE می‌گوید «تو https روی این دامنه هستی»، تا همهٔ
# لینک‌های مطلق درست https ساخته شوند (بدون mixed-content).

{$LIMS_DOMAIN} {
	encode gzip
	# Insert "/senaite" before VirtualHostRoot so the Plone site (which lives
	# at /senaite in Zope) is served at the domain root — clean URLs like
	# https://lims.tppc.ir/login instead of https://lims.tppc.ir/senaite/login.
	rewrite * /VirtualHostBase/https/{host}:443/senaite/VirtualHostRoot{uri}
	reverse_proxy senaite:8080
}
